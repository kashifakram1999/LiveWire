# Django
DJANGO_SECRET_KEY=replace-this-with-a-secure-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis (set for Docker compose by default)
REDIS_URL=redis://redis:6379/0

# PostgreSQL (leave blank to use SQLite fallback)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Optional startup controls
DB_WAIT_ENABLED=true
DB_WAIT_TIMEOUT=60
